<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/ui_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/tvEmoji"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_round_white"
        android:padding="0dp"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:src="@drawable/mayanh" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTopicName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Animals"
            android:textColor="@color/text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTopicDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cute animals • Động vật đáng yêu"
            android:textColor="@color/text_dark"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/ui_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Tap to explore"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:rotation="180"
        android:src="@drawable/ic_arrow" />
</LinearLayout>
